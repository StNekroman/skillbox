{
  "name": "skillbox",
  "private": true,
  "description": "Dev scripts only — the plugins need no install. Tests use Node's built-in runner, no dependencies.",
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "test": "node --test \"plugins/skillbox/scripts/test/*.test.js\" \"tools/test/*.test.js\"",
    "test:fork": "node --test \"plugins/skillbox/scripts/test/{cli,fork-*}.test.js\"",
    "test:doc": "node --test \"plugins/skillbox/scripts/test/doc-*.test.js\" \"tools/test/*.test.js\"",
    "sync": "node tools/sync-doc-check.js",
    "sync:check": "node tools/sync-doc-check.js --check"
  }
}
